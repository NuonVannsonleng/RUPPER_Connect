PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URLS=http://localhost:5173,http://localhost:8080,https://class-connect-pro-rupp.vercel.app

# --- Database (Supabase PostgreSQL) -------------------------------------------------------
# Supabase Dashboard > Connect > "Session pooler" gives you this string. Use the SESSION
# pooler (port 5432 on a host like aws-0-<region>.pooler.supabase.com), not the direct
# connection: the direct one is IPv6-only and hosts like Render can't reach it.
#
# Replace [YOUR-PASSWORD] with your database password, and URL-encode any special characters
# in it (@ becomes %40, # becomes %23, and so on) or the URL will not parse.
DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# SSL is ON by default because Supabase requires it. Set this to false ONLY when pointing at
# a plain local Postgres that has no TLS.
# DB_SSL=false

# Alternative to DATABASE_URL - set all of these instead if you prefer separate fields.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_NAME=postgres

# Signs every session token. Production refuses to start if this is missing, still a
# placeholder, or shorter than 32 characters - anyone who knows the value can mint a token
# for any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_secret_key

# --- Password reset emails ---------------------------------------------------------------
# With none of the options below set, the reset link is written to the server log rather
# than sent. Fine locally; in production it means nobody can reset their own password,
# though an admin can still set one from Admin > Users. Admin > Users also shows a live
# diagnosis of whichever option is active.
#
# The sender address must be one you have verified with your provider. Mail claiming to come
# from a domain you don't control (no-reply@rupp.edu.kh, say) is rejected.
MAIL_FROM=
MAIL_FROM_NAME=RUPPER Connect

# Option 1 (recommended): an HTTP provider. These post over HTTPS, so they keep working on
# hosts that block outbound SMTP - which many do, silently. Set one key only.
BREVO_API_KEY=
RESEND_API_KEY=

# Option 2: SMTP. Works where outbound SMTP isn't blocked. For Gmail you need 2-Step
# Verification on and a 16-character App Password with the spaces taken out; the normal
# account password will not work. If sends time out, the port is blocked - try 465, and if
# that fails too, use option 1.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Legacy alias for MAIL_FROM, kept so existing deployments keep working.
SMTP_FROM=
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# Signup never grants the admin role, so the first admin is designated here.
# Set ADMIN_EMAIL to an account that already exists and it becomes an admin on the next
# restart. Add ADMIN_PASSWORD (6+ characters) if the account doesn't exist yet and should
# be created. Safe to leave set - it does nothing once the account is already an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
