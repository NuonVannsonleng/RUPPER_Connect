PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URLS=http://localhost:5173,http://localhost:8080,https://class-connect-pro-rupp.vercel.app
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=rupper_connect
DB_SSL=false
# Signs every session token. Production refuses to start if this is missing, still a
# placeholder, or shorter than 32 characters - anyone who knows the value can mint a token
# for any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_secret_key

# Password reset emails. Without these the reset link is written to the server log instead
# of being sent, which is fine locally but means users can't reset their own password in
# production - an admin can still set one from Admin > Users.
#
# SMTP_FROM must use the same address as SMTP_USER. Providers reject mail claiming to come
# from a domain you don't control, so an address like no-reply@rupp.edu.kh will not send
# unless you actually own that mailbox.
#
# If sends time out, the host is probably blocking outbound SMTP: try SMTP_PORT=465, and if
# that also fails use an HTTP email API instead. Check Admin > Users for a live diagnosis.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# Signup never grants the admin role, so the first admin is designated here.
# Set ADMIN_EMAIL to an account that already exists and it becomes an admin on the next
# restart. Add ADMIN_PASSWORD (6+ characters) if the account doesn't exist yet and should
# be created. Safe to leave set - it does nothing once the account is already an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
